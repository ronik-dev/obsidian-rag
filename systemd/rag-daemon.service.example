[Unit]
Description=Local RAG Background Daemon
After=network.target

[Service]
Type=simple
# Path to your backend directory
WorkingDirectory=/home/YOUR_USERNAME/YOUR_REPO_DIR/backend

# Path to the environment file 
EnvironmentFile=/home/YOUR_USERNAME/YOUR_REPO_DIR/backend/.env

# Execute Uvicorn using the virtual environment's Python
ExecStart=/home/YOUR_USERNAME/YOUR_REPO_DIR/backend/.venv/bin/uvicorn daemon:app --host 127.0.0.1 --port 8000

# Automatically restart if it crashes
Restart=always
RestartSec=3

# Limit RAM usage if you want to be extra safe on constrained hardware
# MemoryMax=4G 

[Install]
WantedBy=default.target
